      contactForm.reset();
      
      setTimeout(() => {
        formMessage.classList.add('hidden');
      }, 5000);
    });

    // Initialize Element SDK
    if (window.elementSdk) {
      window.elementSdk.init({
        defaultConfig,
        onConfigChange,
        mapToCapabilities,
        mapToEditPanelValues
      });
    }
